# Copy to .env and fill in what you need. Everything is optional for local dev:
# with no keys the app uses mock AI extraction and payments are disabled.

# --- Database (Supabase → Project Settings → Database → Connection string, "Transaction pooler", port 6543)
DATABASE_URL=

# --- Supabase Auth / Storage (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI extraction: mock | google | anthropic
AI_PROVIDER=mock
# Optional model override (defaults: gemini-3.5-flash, claude-sonnet-5-5)
AI_MODEL=
# HS search: none (keyword search, no key) | google (semantic; run npm run hs:embed first)
EMBEDDING_PROVIDER=none
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe (TEST MODE ONLY; sk_test_… keys, live keys are rejected at startup)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting (Upstash Redis free tier; in-memory fallback if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Demo users (npm run auth:demo-users): shared password for the 3 demo accounts, min 12 chars
DEMO_USER_PASSWORD=
