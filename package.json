{
  "name": "nexustrade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "auth:demo-users": "tsx --env-file-if-exists=.env scripts/create-demo-users.ts",
    "hs:embed": "tsx --env-file-if-exists=.env scripts/embed-hs-codes.ts",
    "hs:build": "tsx scripts/build-hs-dataset.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "ai": "^7.0.166",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
